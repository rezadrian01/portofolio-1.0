# =============================================================================
# Environment variables for the portfolio.
# Copy this file to `.env` (or `.env.local`) and fill in the values.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Site domain (required in production)
# -----------------------------------------------------------------------------
# Absolute base URL of the deployed site. Used for metadataBase, canonical URLs,
# Open Graph tags, and the sitemap. In development it falls back to
# http://localhost:3000, but a production build FAILS if this is empty.
# No trailing slash.
DOMAIN=https://www.rezadrian.my.id

# -----------------------------------------------------------------------------
# Contact form -> Telegram Bot (required for /contact form delivery)
# -----------------------------------------------------------------------------
# 1. Create a bot via @BotFather (https://t.me/BotFather) and copy its token.
# 2. Send /start to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# -----------------------------------------------------------------------------
# Google Analytics (optional)
# -----------------------------------------------------------------------------
# Measurement ID, e.g. G-XXXXXXXXXX. If unset, the GA script is not injected.
NEXT_PUBLIC_GA_ID=
